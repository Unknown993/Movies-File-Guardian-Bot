# Telegram Bot Configuration Template
# Copy this file to .env and fill in your values.

# Bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Numeric Telegram ID of the developer / primary admin
DEVELOPER_ID=123456789

# Optional: Comma-separated list of additional admin IDs
# ADMIN_IDS=123456789,987654321

# Optional: Storage channel ID (e.g., -1001234567890) where files are stored / mirrored
# STORAGE_CHANNEL_ID=-1001234567890

# Optional: Dedicated temporary download channels allowed for Mode 2 (comma-separated chat IDs)
# ALLOWED_TEMP_CHANNELS=-1001111111111,-1002222222222

# Default delivery mode: "view_only" (Mode 1) or "downloadable" (Mode 2)
DEFAULT_DELIVERY_MODE=view_only

# Default auto-delete timer in seconds for downloadable mode (e.g., 180 = 3 minutes, 300 = 5 minutes)
DEFAULT_AUTO_DELETE_SECONDS=180

# SQLite database file path
DATABASE_PATH=bot_database.sqlite3

# Optional: MTProto Credentials for Telethon Full-Channel History Indexer & /fast_index
# Obtain from https://my.telegram.org (under 'API development tools')
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Telethon StringSession for cloud hosting (e.g. Heroku) without requiring a local .session file:
# Generate by running: python generate_session_string.py
# TELEGRAM_SESSION_STRING=1BVts...

# Optional: Direct download URL to restore SQLite database on ephemeral cloud platforms (e.g., Heroku)
# DATABASE_DOWNLOAD_URL=https://example.com/bot_database.sqlite3

# Optional: Force Subscription Channel (Numeric ID e.g. -1001234567890 or @channelname)
# AUTH_CHANNEL_ID=-1001234567890

# Optional: Custom Welcome Greetings
# WELCOME_TEXT=👋 Hey {user}!\n\nWelcome to **{chat}**! 🎉
# WELCOME_PIC=https://example.com/welcome_banner.jpg

# Optional: Force Subscription Message
# FORCE_SUB_TEXT=⚠️ **Channel Membership Required**\n\nPlease join our channel to access files.

# Optional: Paywall / Paid-Only Access Control (0 = Off / Free, 1 = On / Paid Members Only)
# PAYWALL_ENABLED=0

